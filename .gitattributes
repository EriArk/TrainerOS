*.sh text eol=lf
# Preserve the owner's original PS2 research CSV attachments byte-for-byte.
docs/data/ps2/*.csv -text whitespace=cr-at-eol
*.ttf binary
# Unified diff context prefixes can precede upstream tabs and blank lines.
*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
# Keep the upstream git-format-patch export byte-for-byte, including its final blank line.
packaging/kernel/iris/0001-upstream-request-keyframe.patch whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof
# Preserve the reused patch's trailing context and the upstream license text.
tools/gamescope-capture/0001-pipewire-buffer-association.patch whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof
tools/gamescope-capture/LICENSE.gamescope text eol=lf whitespace=-blank-at-eof
# Preserve downloaded dependency notices, including the MPL text's upstream space.
tools/remote-play-stream/transport/licenses/* -text
tools/remote-play-stream/transport/licenses/lib*.LICENSE whitespace=-blank-at-eol
# These notices are hashed in the Crates artwork provenance; preserve upstream bytes.
assets/crates/examples/*-LICENSE.txt -text whitespace=-blank-at-eof
