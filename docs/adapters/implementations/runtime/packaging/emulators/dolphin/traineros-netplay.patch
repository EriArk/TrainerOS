+bool NetPlayDialog::StartTrainerGame()
+{
+  const auto client = Settings::Instance().GetNetPlayClient();
+  const auto server = Settings::Instance().GetNetPlayServer();
+  if (!client || !server || !client->DoAllPlayersHaveGame() ||
+      Config::Get(Config::GFX_EFB_SCALE) == 0 || !FindGameFile(m_current_game_identifier))
+    return false;
+  const bool result = server->RequestStartGame();
+  if (result)
+    SetOptionsEnabled(false);
+  return result;
+}
