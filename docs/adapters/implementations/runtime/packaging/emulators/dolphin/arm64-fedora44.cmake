# Fedora 44 ARM64 sysroot with native Clang/Qt tools. Used by the adjacent image.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_SYSROOT /opt/arm64)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET aarch64-redhat-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-redhat-linux-gnu)
set(CMAKE_C_FLAGS_INIT "--gcc-toolchain=/opt/arm64/usr")
set(CMAKE_CXX_FLAGS_INIT "--gcc-toolchain=/opt/arm64/usr")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_FIND_ROOT_PATH /opt/arm64)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(QT_HOST_PATH /usr CACHE PATH "Native Qt tools")
set(QT_HOST_PATH_CMAKE_DIR /usr/lib64/cmake CACHE PATH "Native Qt tool metadata")
set(CMAKE_CROSSCOMPILING_EMULATOR /usr/bin/qemu-aarch64;-L;/opt/arm64)
# Dolphin's own PKG_CONFIG_LIBDIR lists lib, whereas Fedora uses lib64.
set(ENV{PKG_CONFIG_PATH} /opt/arm64/usr/lib64/pkgconfig)
