+      }
+      if (!executable->IsValid() || executable->GetEntryPoint() == 0)
+        return EXIT_FAILURE;
+      auto json = picojson::object();
+      json["platform"] = picojson::value(std::string(executable->IsWii() ? "wii" : "gc"));
+      json["executable"] = picojson::value(true);
