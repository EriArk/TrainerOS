+// Bound an unfinished wire operation; partial frames must fail, never be retried
+// as a fresh packet. The caller already closes failed sessions and frees slots.
+#ifndef RELAY_IO_TIMEOUT_MS
+#define RELAY_IO_TIMEOUT_MS 15000
+#endif
+static long long relay_now_ms(void) {
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (long long)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+static int relay_wait_io(int fd, short events, long long deadline) {
+    long long remaining = deadline - relay_now_ms();
+    if (remaining <= 0) { errno = ETIMEDOUT; return -1; }
+    struct pollfd pfd = {.fd = fd, .events = events};
+    // Short waits retain the existing cooperative abort path without busy-spinning.
+    int result = poll(&pfd, 1, remaining < 10 ? (int)remaining : 10);
+    return result < 0 && errno != EINTR ? -1 : 0;
+}
