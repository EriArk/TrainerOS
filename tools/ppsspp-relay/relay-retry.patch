+++ b/Core/HLE/AdhocRelayRetry.h
@@ -0,0 +1,21 @@
+// Copyright (c) 2026 TrainerOS contributors. SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <chrono>
+
+// Retry transport preparation without restarting the game or selecting a match.
+// One failed socket must not disable relay access for the lifetime of Ad Hoc.
+class AdhocRelayRetry {
+public:
+    using Clock = std::chrono::steady_clock;
+    bool Ready(Clock::time_point now = Clock::now()) const { return now >= next_; }
+    bool Failing() const { return failing_; }
+    void Failed(Clock::time_point now = Clock::now()) {
+        if (!failing_) { first_ = now; failing_ = true; }
+        next_ = now + (now - first_ < std::chrono::seconds(15)
+            ? std::chrono::seconds(1) : std::chrono::seconds(5));
+    }
+    void Reset() { failing_ = false; first_ = {}; next_ = {}; }
+private:
+    bool failing_ = false;
+    Clock::time_point first_{}, next_{};
+};
